# DockWatch Environment Configuration
# Copy this file to .env and fill in your values

# REQUIRED: JWT Secret for authentication
# Generate a secure secret with: openssl rand -hex 32
DOCKWATCH_JWT_SECRET=

# REQUIRED: Encryption key for TOTP and secrets
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DOCKWATCH_ENCRYPTION_KEY=

# Database path (optional, defaults to /app/data/dockwatch.db)
DOCKWATCH_DB_PATH=/app/data/dockwatch.db

# Docker socket path (optional, defaults to /var/run/docker.sock)
DOCKWATCH_DOCKER_SOCKET=/var/run/docker.sock
